{
  "repository_type": "monolith",
  "parts_count": 1,
  "parts": [
    {
      "part_id": "landing",
      "display_name": "Coupr Landing Page",
      "project_type_id": "web",
      "root_path": "/",
      "key_files": [
        "index.html",
        "lambdas/contact-form/index.js",
        "infra/terraform/main.tf",
        "infra/terraform/cloudfront.tf",
        "infra/terraform/lambda.tf"
      ],
      "tech_stack": {
        "frontend": ["HTML5", "Tailwind CSS (CDN)", "Swiper.js v11", "Vanilla JS"],
        "backend": ["Node.js 20.x", "@aws-sdk/client-ses"],
        "infra": ["Terraform >= 1.0", "AWS Provider ~> 5.0"],
        "aws_services": ["S3", "CloudFront", "Route53", "API Gateway v2 HTTP", "Lambda", "SES", "IAM", "CloudWatch Logs", "ACM"]
      },
      "documentation_requirements": {
        "requires_api_scan": true,
        "requires_data_models": false,
        "requires_state_management": false,
        "requires_ui_components": true,
        "requires_deployment_config": true,
        "requires_asset_inventory": true,
        "requires_hardware_docs": false
      },
      "entry_points": {
        "frontend": "index.html",
        "backend": "lambdas/contact-form/index.js#handler",
        "infra": "infra/terraform/main.tf"
      }
    }
  ],
  "integration_points": [
    {
      "from": "frontend (index.html)",
      "to": "backend (Lambda via API Gateway)",
      "type": "REST HTTP",
      "endpoint": "POST /contact",
      "auth": "none (public)",
      "cors": "Access-Control-Allow-Origin: *"
    },
    {
      "from": "Lambda contact-form",
      "to": "Amazon SES",
      "type": "AWS SDK v3",
      "operation": "SendEmailCommand",
      "identity": "contact@coupr.io"
    }
  ]
}
